---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import kontakt from '../assets/kontakt.webp';
---

<MainLayout title="Kontakt | Nico Egerer" description="Nimm Kontakt mit Nico Egerer auf, per Formular, E-Mail oder LinkedIn.">
  <style>
    .contact-section { background: var(--hg); padding: var(--gap-xl) var(--gap-m); }
    .contact-section-inner { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--gap-l); align-items: start; }
    .contact-subline-dark { color: var(--txt-leise); font-size: 0.95rem; margin-bottom: 2rem; }
    .contact-form-ext { display: flex; flex-direction: column; gap: 0.7rem; }
    .cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .cf-field { display: flex; flex-direction: column; gap: 0.35rem; }
    .cf-field label { color: var(--txt-leise); font-size: 0.88rem; font-weight: 500; }
    .cf-input-light { background: var(--hg-2); border: 1.5px solid var(--linie-weich); border-radius: var(--r-s); padding: 0.8rem 1rem; font-size: 0.95rem; font-family: var(--font-base); color: var(--txt); width: 100%; outline: none; transition: border-color 0.2s; }
    .cf-input-light::placeholder { color: #bbb; }
    .cf-input-light:focus { border-color: var(--blau); }
    .cf-textarea-light { height: 160px; resize: vertical; }
    .cf-submit { margin-top: 0.5rem; align-self: flex-start; }
    .cf-success { background: rgba(80,200,120,0.1); color: #3a9d5c; border: 1px solid #3a9d5c44; }
    .cf-error { background: rgba(220,80,80,0.1); color: #c04040; border: 1px solid #c0404044; }
    .contact-info-title { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 400; color: var(--txt); margin-bottom: 0.5rem; }
    .contact-info-sub { color: var(--txt-leise); font-size: 0.92rem; margin-bottom: 1.8rem; }
    .contact-channels { display: flex; flex-direction: column; gap: 0.8rem; margin-bottom: 1.5rem; }
    .contact-channel { display: flex; align-items: center; gap: 1rem; background: var(--hg-2); border-radius: var(--r); padding: 1rem 1.3rem; box-shadow: 0 2px 12px rgba(0,0,0,0.07); border: 1.5px solid transparent; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
    .contact-channel:hover { transform: translateX(4px); border-color: var(--blau); box-shadow: 0 6px 24px rgba(0,0,0,0.1); }
    .channel-icon { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--hg); }
    .channel-icon svg { width: 18px; height: 18px; }
    .contact-channel:hover .channel-icon { background: rgba(152,213,235,0.25); }
    .channel-text { display: flex; flex-direction: column; gap: 0.1rem; }
    .channel-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--txt-schwach); font-family: var(--font-rund); }
    .channel-value { font-size: 0.92rem; color: var(--txt); font-weight: 500; }
    .response-badge { display: flex; align-items: center; gap: 1rem; background: rgba(152,213,235,0.1); border: 1.5px solid rgba(152,213,235,0.3); border-radius: var(--r); padding: 1rem 1.3rem; font-size: 1.3rem; }
    .response-badge strong { color: var(--txt); font-size: 0.95rem; display: block; margin-bottom: 0.15rem; }
    .response-badge p { color: var(--txt-leise); font-size: 0.85rem; margin: 0; }
    .page-hero-kontakt .page-hero-inner { display: grid; grid-template-columns: 1fr auto; gap: var(--gap-l); align-items: end; }
    .kontakt-portrait {
      width: clamp(190px, 20vw, 260px);
      border-radius: var(--r);
      overflow: hidden;
      /* Weichzeichnung nicht groesser als der Versatz, sonst laeuft der
         Schatten oben ueber die Rundung hinaus */
      filter: drop-shadow(0 1px 2px rgba(40,34,26,0.12))
              drop-shadow(0 14px 14px rgba(40,34,26,0.18));
    }
    .kontakt-portrait img { display: block; width: 100%; height: auto; }

    .profiles-section { background: var(--hg-2); padding: var(--gap-xl) var(--gap-m); }
    .profiles-inner { max-width: var(--max-w); margin: 0 auto; }
    .profiles-header { text-align: center; margin-bottom: var(--gap-l); }
    .profiles-sub { color: var(--txt-leise); font-size: 1rem; max-width: 500px; margin: 0.8rem auto 0; }
    .profiles-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--gap-m); }
    .profile-card { background: var(--hg); border-radius: var(--r); padding: 2rem 2rem 1.8rem; display: flex; flex-direction: column; gap: 0.5rem; box-shadow: 0 4px 24px rgba(0,0,0,0.06); border: 2px solid transparent; transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease; }
    .profile-card:hover { box-shadow: 0 16px 48px rgba(0,0,0,0.13); }
    .profile-github:hover { border-color: #24292e; }
    .profile-linkedin:hover { border-color: #0a66c2; }
    .profile-web:hover { border-color: var(--blau); }
    .profile-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.8rem; }
    .profile-icon { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; }
    .profile-icon svg { width: 28px; height: 28px; }
    .profile-icon-github { background: #24292e; }
    .profile-icon-linkedin { background: #0a66c2; }
    .profile-icon-web { background: var(--blau); }
    .profile-badge { font-family: var(--font-rund); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.2rem 0.7rem; border-radius: 20px; background: var(--hg-2); color: #888; }
    .profile-name { font-family: var(--font-serif); font-size: 1.4rem; font-weight: 500; color: var(--txt-stark); }
    .profile-handle { font-size: 0.85rem; color: var(--txt-schwach); margin-top: -0.3rem; margin-bottom: 0.2rem; }
    .profile-desc { color: var(--txt-leise); font-size: 0.9rem; line-height: 1.65; flex: 1; }
    .profile-cta { font-size: 0.9rem; color: var(--akzent-2); font-weight: 500; margin-top: 0.8rem; transition: transform 0.2s ease; }
    .profile-card:hover .profile-cta { opacity: 1; }

    @media (max-width: 900px) {
      .page-hero-kontakt .page-hero-inner { grid-template-columns: 1fr; gap: var(--gap-m); }
      .kontakt-portrait { order: -1; width: 130px; }
      .contact-section-inner { grid-template-columns: 1fr; }
      .cf-row { grid-template-columns: 1fr; }
      .profiles-grid { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }
    }
    @media (max-width: 700px) {
      .channel-label { font-size: 0.8rem; }
      .profile-badge { font-size: 0.78rem; }
      .contact-channel { padding: 1.1rem 1.2rem; }
      .profiles-header { text-align: left; }
      .profiles-sub { margin-left: 0; }
    }
  </style>

  <section class="page-hero page-hero-kontakt">
    <div class="page-hero-inner">
      <div class="page-hero-worte">
        <span class="label white">Schreib mir</span>
        <h1 class="page-hero-title">Lass uns <span class="page-hero-accent">reden</span></h1>
        <p class="page-hero-sub" data-auf="unschaerfe" data-auf-verzug="120">Ich antworte schnell, egal ob Projekt, Frage oder einfach Hallo.</p>
      </div>
      <div class="kontakt-portrait" data-auf="skalieren" data-auf-verzug="220" data-zeiger="bild">
        <Image src={kontakt} alt="Ich vor der Skyline von New York" quality={88} widths={[260, 520, 780]} sizes="260px" />
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="contact-section-inner">
      <div class="contact-form-col reveal">
        <span class="label">Direktnachricht</span>
        <h2 class="section-heading dark" data-buchstaben>Kontaktformular</h2>
        <p class="contact-subline-dark">Füll das Formular aus, ich melde mich innerhalb von 24 Stunden.</p>
        <form class="contact-form-ext" id="contact-form">
          <div class="cf-row">
            <div class="cf-field"><label for="cf-name">Vorname &amp; Nachname</label><input type="text" id="cf-name" name="name" maxlength="256" class="cf-input-light" placeholder="Max Mustermann" required /></div>
            <div class="cf-field"><label for="cf-email">E-Mail Adresse</label><input type="email" id="cf-email" name="email" maxlength="256" class="cf-input-light" placeholder="max@beispiel.de" required /></div>
          </div>
          <div class="cf-field">
            <label for="cf-subject">Betreff</label>
            <select id="cf-subject" name="subject" class="cf-input-light">
              <option value="">Bitte auswählen…</option>
              <option value="projekt">Zusammenarbeit / Projekt</option>
              <option value="ausbildung">Ausbildung / Job</option>
              <option value="frage">Allgemeine Frage</option>
              <option value="feedback">Feedback</option>
              <option value="anderes">Anderes</option>
            </select>
          </div>
          <div class="cf-field"><label for="cf-msg">Nachricht</label><textarea id="cf-msg" name="message" maxlength="5000" required placeholder="Deine Nachricht…" class="cf-input-light cf-textarea-light"></textarea></div>
          <button type="submit" class="btn btn-blau cf-submit">Nachricht senden</button>
        </form>
        <div class="cf-success" id="cf-success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg> Danke! Deine Nachricht wurde gesendet.</div>
        <div class="cf-error" id="cf-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg> Fehler beim Senden. Bitte versuche es erneut.</div>
      </div>
      <div class="contact-info-col reveal reveal-delay-2">
        <span class="label">Direktkontakt</span>
        <h3 class="contact-info-title">Andere Wege</h3>
        <p class="contact-info-sub">Du erreichst mich auch direkt über diese Kanäle:</p>
        <div class="contact-channels" data-staffel="seite" data-staffel-schritt="90">
          <a href="mailto:nico@nicoegerer.de" class="contact-channel">
            <span class="channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#25221e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg></span>
            <div class="channel-text"><span class="channel-label">E-Mail</span><span class="channel-value">nico@nicoegerer.de</span></div>
          </a>
          <button type="button" class="kopieren" data-kopieren="nico@nicoegerer.de" data-fertig="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span class="kopieren-text">Kopieren</span>
          </button>
          <a href="https://www.linkedin.com/in/nico-egerer/" target="_blank" rel="noopener" class="contact-channel">
            <span class="channel-icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="#25221e"><path d="M0 2.865C0 1.2825 1.315 0 2.9375 0H37.0625C38.685 0 40 1.2825 40 2.865V37.135C40 38.7175 38.685 40 37.0625 40H2.9375C1.315 40 0 38.7175 0 37.135V2.865ZM12.3575 33.485V15.4225H6.355V33.485H12.3575ZM9.3575 12.955C11.45 12.955 12.7525 11.57 12.7525 9.835C12.715 8.0625 11.4525 6.715 9.3975 6.715C7.3425 6.715 6 8.065 6 9.835C6 11.57 7.3025 12.955 9.3175 12.955H9.3575ZM21.6275 33.485V23.3975C21.6275 22.8575 21.6675 22.3175 21.8275 21.9325C22.26 20.855 23.2475 19.7375 24.9075 19.7375C27.08 19.7375 27.9475 21.3925 27.9475 23.8225V33.485H33.95V23.125C33.95 17.575 30.99 14.995 27.04 14.995C23.855 14.995 22.4275 16.745 21.6275 17.9775V18.04H21.5875L21.6275 17.9775V15.4225H15.6275C15.7025 17.1175 15.6275 33.485 15.6275 33.485H21.6275Z"/></svg></span>
            <div class="channel-text"><span class="channel-label">LinkedIn</span><span class="channel-value">linkedin.com/in/nico-egerer</span></div>
          </a>
          <a href="https://github.com/nicoegerer" target="_blank" rel="noopener" class="contact-channel">
            <span class="channel-icon" aria-hidden="true"><svg viewBox="0 0 35 40" fill="none"><path d="M23.7223 38.5V33.1976C23.7889 32.3167 23.6744 31.431 23.3863 30.5996C23.0981 29.7682 22.643 29.01 22.0512 28.3756C27.6334 27.7289 33.5 25.5304 33.5 15.4429C33.4995 12.8634 32.5448 10.3829 30.8333 8.51467C31.6437 6.25793 31.5864 3.76348 30.6733 1.5495C30.6733 1.5495 28.5756 0.902868 23.7223 4.28384C19.6476 3.13619 15.3525 3.13619 11.2779 4.28384C6.42456 0.902868 4.32679 1.5495 4.32679 1.5495C3.41367 3.76348 3.35638 6.25793 4.16679 8.51467C2.44257 10.3967 1.48684 12.8997 1.50014 15.4983C1.50014 25.5119 7.36676 27.7105 12.949 28.431C12.3641 29.0591 11.913 29.8081 11.6251 30.6294C11.3372 31.4506 11.2188 32.3258 11.2779 33.1976V38.5" stroke="#25221e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <div class="channel-text"><span class="channel-label">GitHub</span><span class="channel-value">github.com/nicoegerer</span></div>
          </a>
        </div>
        <div class="response-badge">
          <span class="channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#25221e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <div><strong>Schnelle Antwortzeit</strong><p>In der Regel innerhalb von 24 Stunden.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="profiles-section" id="plattformen">
    <div class="profiles-inner">
      <div class="profiles-header reveal">
        <span class="label">Online-Präsenz</span>
        <h2 class="section-heading dark" data-buchstaben>Plattformen &amp; Netzwerke</h2>
        <p class="profiles-sub">Hier findest du meinen Code, mein Netzwerk und mein Portfolio.</p>
      </div>
      <div class="profiles-grid" data-staffel="kippen" data-staffel-schritt="110">
        <a href="https://github.com/nicoegerer" target="_blank" rel="noopener" class="profile-card profile-github reveal">
          <div class="profile-card-top">
            <div class="profile-icon profile-icon-github" aria-hidden="true">
              <svg viewBox="0 0 35 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M23.7223 38.5V33.1976C23.7889 32.3167 23.6744 31.431 23.3863 30.5996C23.0981 29.7682 22.643 29.01 22.0512 28.3756C27.6334 27.7289 33.5 25.5304 33.5 15.4429C33.4995 12.8634 32.5448 10.3829 30.8333 8.51467C31.6437 6.25793 31.5864 3.76348 30.6733 1.5495C30.6733 1.5495 28.5756 0.902868 23.7223 4.28384C19.6476 3.13619 15.3525 3.13619 11.2779 4.28384C6.42456 0.902868 4.32679 1.5495 4.32679 1.5495C3.41367 3.76348 3.35638 6.25793 4.16679 8.51467C2.44257 10.3967 1.48684 12.8997 1.50014 15.4983C1.50014 25.5119 7.36676 27.7105 12.949 28.431C12.3641 29.0591 11.913 29.8081 11.6251 30.6294C11.3372 31.4506 11.2188 32.3258 11.2779 33.1976V38.5" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <span class="profile-badge">Code</span>
          </div>
          <h3 class="profile-name">GitHub</h3>
          <p class="profile-handle">@nicoegerer</p>
          <p class="profile-desc">Meine öffentlichen Repositories, von C++ Spielen über Python Scripts bis zu dieser Website. Hier lebt mein Code.</p>
          <div class="profile-cta">Profil ansehen →</div>
        </a>

        <a href="https://www.linkedin.com/in/nico-egerer/" target="_blank" rel="noopener" class="profile-card profile-linkedin reveal reveal-delay-1">
          <div class="profile-card-top">
            <div class="profile-icon profile-icon-linkedin" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 2.865C0 1.2825 1.315 0 2.9375 0H37.0625C38.685 0 40 1.2825 40 2.865V37.135C40 38.7175 38.685 40 37.0625 40H2.9375C1.315 40 0 38.7175 0 37.135V2.865ZM12.3575 33.485V15.4225H6.355V33.485H12.3575ZM9.3575 12.955C11.45 12.955 12.7525 11.57 12.7525 9.835C12.715 8.0625 11.4525 6.715 9.3975 6.715C7.3425 6.715 6 8.065 6 9.835C6 11.57 7.3025 12.955 9.3175 12.955H9.3575ZM21.6275 33.485V23.3975C21.6275 22.8575 21.6675 22.3175 21.8275 21.9325C22.26 20.855 23.2475 19.7375 24.9075 19.7375C27.08 19.7375 27.9475 21.3925 27.9475 23.8225V33.485H33.95V23.125C33.95 17.575 30.99 14.995 27.04 14.995C23.855 14.995 22.4275 16.745 21.6275 17.9775V18.04H21.5875L21.6275 17.9775V15.4225H15.6275C15.7025 17.1175 15.6275 33.485 15.6275 33.485H21.6275Z" fill="white"/></svg>
            </div>
            <span class="profile-badge">Netzwerk</span>
          </div>
          <h3 class="profile-name">LinkedIn</h3>
          <p class="profile-handle">nico-egerer</p>
          <p class="profile-desc">Mein professionelles Netzwerk. Ausbildung, Erfahrung und berufliche Verbindungen auf einen Blick.</p>
          <div class="profile-cta">Profil ansehen →</div>
        </a>

        <a href="/projects" class="profile-card profile-web reveal reveal-delay-2">
          <div class="profile-card-top">
            <div class="profile-icon profile-icon-web" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <span class="profile-badge">Portfolio</span>
          </div>
          <h3 class="profile-name">Meine Projekte</h3>
          <p class="profile-handle">nicoegerer.de/projects</p>
          <p class="profile-desc">Von C++ Games über Raspberry-Pi-Hardware bis zu dieser Website, alle Arbeiten mit Technik und Hintergrund.</p>
          <div class="profile-cta">Projekte ansehen →</div>
        </a>
      </div>
    </div>
  </section>

</MainLayout>

---
import MainLayout from '../layouts/MainLayout.astro';
import FaecherGalerie from '../components/FaecherGalerie.astro';
import AsciiForest from '../components/AsciiForest.astro';
import BergSzene from '../components/ui/berg-szene';
import ZeichenPhysik from '../components/ZeichenPhysik.astro';
import ScrollAufdecken from '../components/ScrollAufdecken.astro';
import Hoehenprofil from '../components/Hoehenprofil.astro';
import { Image } from 'astro:assets';
import gipfel from '../assets/gipfel.webp';
---

<MainLayout title="Über Mich | Nico Egerer" description="Über Mich">
  <style>
    .about-split { background: var(--hg); padding: var(--gap-xl) var(--gap-m); }
    .about-split-inner { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 1fr 1.1fr; gap: var(--gap-l); align-items: center; }
    .about-bild {
      border-radius: var(--r);
      overflow: hidden;

      filter: drop-shadow(0 1px 2px rgba(40,34,26,0.10))
              drop-shadow(0 14px 14px rgba(40,34,26,0.16));
    }
    .about-bild-img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; object-position: 50% 42%; }
    .about-fliess { color: var(--txt-leise); }
    .about-actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 1.8rem; flex-wrap: wrap; }
    .values-section { background: var(--hg-betont); padding: var(--gap-xl) var(--gap-m); }
    .values-inner { max-width: var(--max-w); margin: 0 auto; }
    .values-header { text-align: center; margin-bottom: var(--gap-l); }
    .values-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: var(--gap-m); }
    .value-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--r); padding: 2rem 1.5rem; transition: background 0.3s, transform 0.3s; }
    .value-card:hover { background: rgba(255,255,255,0.09); }
    .value-icon { width: 44px; height: 44px; margin-bottom: 1rem; color: var(--blau); }
    .value-icon svg { width: 100%; height: 100%; }
    .value-card h3 { color: var(--weiss); font-family: var(--font-serif); font-size: 1.15rem; font-weight: 500; margin-bottom: 0.6rem; }
    .value-card p { color: rgba(255,255,255,0.55); font-size: 0.9rem; line-height: 1.65; }
    .crosslink-section { background: var(--hg-2); padding: var(--gap-l) var(--gap-m); }
    .crosslink-inner { max-width: var(--max-w); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: var(--gap-l); flex-wrap: wrap; }
    .crosslink-text { max-width: 560px; }
    .crosslink-sub { color: var(--txt-leise); font-size: 0.98rem; line-height: 1.7; }
    .crosslink-actions { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }
    .hobbies-section { background: var(--hg); padding: var(--gap-xl) var(--gap-m); }
    .hobbies-inner { max-width: var(--max-w); margin: 0 auto; }
    .hobbies-header { text-align: center; margin-bottom: var(--gap-l); }
    .hobbies-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--gap-m); }
    .hobby-card { background: var(--hg-2); border-radius: var(--r); padding: 2.5rem 2rem; text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,0.07); transition: transform 0.3s, box-shadow 0.3s; }
    .hobby-card:hover { box-shadow: 0 12px 40px rgba(0,0,0,0.12); }
    .hobby-icon { width: 46px; height: 46px; margin: 0 auto 1rem; color: #6f9bad; }
    .hobby-icon svg { width: 100%; height: 100%; }
    .hobby-card h4 { font-family: var(--font-serif); font-size: 1.2rem; font-weight: 500; color: var(--txt); margin-bottom: 0.6rem; }
    .hobby-card p { color: var(--txt-leise); font-size: 0.92rem; line-height: 1.6; }
    .about-cta { background: linear-gradient(135deg, var(--hg-betont-2) 0%, var(--hg-betont) 100%); padding: var(--gap-xl) var(--gap-m); text-align: center; }
    .about-cta-inner { max-width: 640px; margin: 0 auto; }
    .about-cta-inner p { color: rgba(255,255,255,0.6); font-size: 1.05rem; margin: 1rem 0 2rem; }
    .cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    @media (max-width: 900px) {
      .about-split-inner { grid-template-columns: 1fr; gap: var(--gap-m); }
      .about-bild-img { aspect-ratio: 4 / 3; }
      .values-grid { grid-template-columns: repeat(2,1fr); }
      .crosslink-inner { flex-direction: column; align-items: flex-start; gap: var(--gap-m); }
      .hobbies-cards { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
    }
    .about-berge {
      -webkit-mask-image: linear-gradient(to top, #000 25%, transparent 88%);
              mask-image: linear-gradient(to top, #000 25%, transparent 88%);
    }
    .about-wald {
      -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, #000 25%, transparent 80%);
              mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, #000 25%, transparent 80%);
    }
    .page-hero-inner { position: relative; z-index: 2; }

    .berg-ersatz { position: absolute; inset: 0; z-index: 0; }
    .berg-ersatz svg { width: 100%; height: 100%; display: block; }
    .be-fern { fill: #14313f; }
    .be-nah  { fill: #0d2029; }
    @media (min-width: 860px) { .berg-ersatz { display: none; } }

    .page-hero-berg { background: #0b1a24; border-bottom-color: #16303d; }
    .page-hero-berg::before { display: none; }

    .page-hero-berg::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background:
        linear-gradient(to right,
          rgba(5, 14, 20, 0.94) 0%,
          rgba(5, 14, 20, 0.88) 26%,
          rgba(5, 14, 20, 0.52) 52%,
          rgba(5, 14, 20, 0.12) 76%,
          transparent 92%),
        linear-gradient(to top,
          rgba(5, 14, 20, 0.45) 0%,
          transparent 42%);
    }

    .page-hero-berg .page-hero-title { color: #f6f2ea; }
    .page-hero-berg .page-hero-sub { color: rgba(246,242,234,0.86); }
    .page-hero-berg .label,
    .page-hero-berg .label.white { color: rgba(246,242,234,0.82); }
    .page-hero-berg .page-hero-accent { color: #8ed4ec; }

    .galerie-huelle { position: relative; overflow: hidden; }
    @media (max-width: 600px) { .values-grid { grid-template-columns: 1fr; } }
    @media (max-width: 900px) {
      .values-header, .hobbies-header { text-align: left; }
    }
  </style>

  <section class="page-hero page-hero-berg">
    <div class="berg-ersatz" aria-hidden="true">
      <svg viewBox="0 0 1200 320" preserveAspectRatio="none">
        <path class="be-fern" d="M0 320 L140 176 L260 232 L400 132 L540 208 L680 150 L840 220 L980 146 L1090 198 L1200 160 L1200 320 Z"/>
        <path class="be-nah"  d="M0 320 L110 232 L240 268 L380 200 L520 252 L660 210 L820 258 L960 204 L1080 248 L1200 216 L1200 320 Z"/>
      </svg>
    </div>
    <BergSzene client:media="(min-width: 860px)" />
    <div class="page-hero-inner">
      <span class="label white">Abseits vom Schreibtisch</span>
      <h1 class="page-hero-title">Bergsteigen, Klettern, <span class="page-hero-accent">Triathlon</span></h1>
      <p class="page-hero-sub" data-auf="unschaerfe" data-auf-verzug="120">Triathlon, Klettern und die Alpen. Was ich mache, wenn der Rechner aus ist.</p>
    </div>
  </section>

  <section class="about-split">
    <div class="about-split-inner">
      <div class="about-bild" data-auf="skalieren" data-zeiger="bild">
        <Image
          src={gipfel}
          alt="Am Gipfelkreuz, im Hintergrund die Alpen"
          class="about-bild-img"
          quality={88}
          widths={[560, 840, 1120]}
          sizes="(max-width: 900px) 100vw, 46vw"
          loading="lazy"
        />
      </div>

      <div class="about-split-text">
        <span class="label">Warum ich das mache</span>
        <ZeichenPhysik als="h2" klasse="section-heading dark" text="Über Mich" />
        <div class="about-fliess">
          <ScrollAufdecken
          absaetze={[
              'Ich bin 19 Jahre alt und komme aus Wolfratshausen, südlich von München. Neben dem Programmieren spielt Sport eine große Rolle in meiner Freizeit.',
              'Am liebsten bin ich draußen unterwegs. Egal ob mit dem Rennrad, beim Laufen, Schwimmen oder Wakeboarden. Besonders Triathlon finde ich interessant, weil er gleich drei Sportarten miteinander verbindet und am meisten Disziplin benötigt. ',
              'Durch die Nähe zu den Alpen bin ich auch gerne in den Bergen unterwegs. Sport ist für mich vor allem ein guter Ausgleich zum Alltag am Rechner. Ich probiere gerne neue Dinge aus und finde es cool, wenn ich merke, dass ich mich irgendwo verbessere.',
            ]}
          />
        </div>
        <div class="about-actions reveal reveal-delay-4">
          <a href="#disziplinen" class="btn btn-dark-outline">Meine Disziplinen</a>
          <a href="/" class="link-arrow">Zur beruflichen Seite →</a>
        </div>
      </div>
    </div>
  </section>

  <Hoehenprofil />

  <section class="values-section" id="disziplinen">
    <div class="values-inner">
      <div class="values-header reveal">
        <span class="label white" data-auf="seite">Neben dem Triathlon</span>
        <h2 class="section-heading white" data-buchstaben>Weitere Sportarten</h2>
      </div>
      <div class="values-grid" data-staffel="kippen" data-staffel-schritt="110">


        <div class="value-card">
          <div class="value-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round">
              <circle cx="13" cy="4.5" r="1.7"/>
              <path d="M12.5 7 11 12l-3 4m3-4 4 4M12 9l-5-2-3 2m9-1 4 3"/>
              <path d="M4 18c4 1 12 1 16-1"/>
              <path d="M2 21c2-1 4-1 6 0s4 1 6 0 4-1 8 0"/>
            </svg>
          </div>
          <h3>Wakeboarden &amp; Snowboarden</h3>
          <p>Im Sommer bin ich gerne am Wakeboardlift unterwegs und probiere neue Tricks aus. Im Winter geht esstattdessen mit dem Snowboard auf die Piste. </p>
        </div>        
        
        <div class="value-card">
          <div class="value-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 2l-3 5 2 5-3 5 2 5"/>
              <circle cx="9" cy="6" r="2"/>
              <path d="m10 9 2 5-1 3"/>
              <path d="m11 10 4-4 3 1"/>
              <path d="m11 11-4 3-3-1"/>
              <path d="m11 17-4 4"/>
              <path d="m11 17 5 2 2-2"/>
            </svg>            
          </div>
          <h3>Klettern</h3>
          <p>Beim Klettern geht es für mich vor allem darum, neue Routen auszuprobieren und auch schwierigere Stellen irgendwann zu schaffen.</p>
        </div>
        
        <div class="value-card">
          <div class="value-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m2 20 8-14 4 7 3-5 5 12H2Z"/>
              <path d="m7 11 3 3 2-2m3 1 2 3 2-2"/>
              <path d="M10 6V2m0 0 3 1m-3-1L7 3"/>
            </svg>
          </div>
          <h3>Bergsteigen</h3>
          <p>In den Bergen interessieren mich vor allem Hochtouren und anspruchsvolle Aufstiege. Besonders gerne bin ich dabei in den Alpen unterwegs.</p>
        </div>
        
      <div class="value-card">
        <div class="value-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 10V8a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v2"/>
            <path d="M3 10v3a5 5 0 0 0 5 5h2l2-3 2 3h2a5 5 0 0 0 5-5v-3"/>
            <path d="M3 10h18"/>
            <path d="M12 15v-5"/>
          </svg>
        </div>
        <h3>Tauchen</h3>
        <p>Ich habe meinen Open Water Diver gemacht und gehe gerne tauchen, wenn sich die Gelegenheit ergibt.</p>
      </div>

      </div>
    </div>
  </section>

  <section class="crosslink-section">
    <div class="crosslink-inner reveal">
      <div class="crosslink-text">
        <span class="label">Neben dem Sport</span>
        <h2 class="section-heading dark">Und beruflich?</h2>
        <p class="crosslink-sub">Was ich entwickle, womit ich arbeite und was ich bisher gebaut habe, steht auf den anderen Seiten: Startseite, Projekte und Erfahrung.</p>
      </div>
      <div class="crosslink-actions">
        <a href="/" class="btn btn-dark-outline">Zur Startseite</a>
        <a href="/projects" class="link-arrow">Projekte ansehen →</a>
      </div>
    </div>
  </section>

  <section class="hobbies-section">

    <div class="hobbies-inner">
      <div class="hobbies-header reveal">
        <span class="label" data-auf="seite">Abseites vom Sport</span>
        <h2 class="section-heading dark" data-buchstaben>
          Andere Interessen
        </h2>
      </div>
    
      <div class="hobbies-cards" data-staffel="skalieren" data-staffel-schritt="110">
        <div class="hobby-card">
          <div class="hobby-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"/>
              <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>
            </svg>
          </div>
          <h4>Reisen</h4>
          <p>Ich reise gerne und entdecke neue Länder und Städte. Besonders mag ich Roadtrips, bei denen man unterwegs viele verschiedene Orte kennenlernt.</p>
        </div>
    
        <div class="hobby-card">
          <div class="hobby-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="5" width="20" height="14" rx="2"/>
              <path d="M6 5v9M10 5v9M14 5v9M18 5v9M2 14h20"/>
              <path d="M8 5v7M12 5v7M16 5v7"/>
            </svg>
          </div>
          <h4>Klavierspielen</h4>
          <p>Ich habe einige Jahre Klavierunterricht genommen und spiele auch heute noch gelegentlich Klavier. Musik gehört weiterhin zu meinen Interessen.</p>
        </div>
    

        <div class="hobby-card">
          <div class="hobby-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 14h18l-3 5H6l-3-5Z"/>
              <path d="M8 14V8h8v6"/>
              <path d="M12 8V4"/>
              <path d="M8 4h8"/>
              <path d="M2 21c2-1 4-1 6 0s4 1 6 0 4-1 8 0 4-1 8 0"/>
            </svg>
          </div>
          <h4>Motorbootfahren</h4>
          <p> Ich habe meinen Sportbootführerschein gemacht Auch wenn ich nur selten selbst auf dem Wasser unterwegs bin, macht mir das Bootfahren viel Spaß. </p>
        </div>
        
      </div>
    </div>
    
  </section>

  <div class="galerie-huelle">
    <AsciiForest klasse="about-wald" deckkraft={0.28} />
    <FaecherGalerie />
  </div>

  <section class="about-cta">
    <div class="about-cta-inner reveal">
      <span class="label white">Noch Fragen?</span>
      <h2 class="section-heading white">Lass uns reden</h2>
      <p>Ich freue mich über neue Kontakte oder spannende Projekte</p>
      <div class="cta-btns">
        <a href="/contact" class="btn btn-outline">Kontakt aufnehmen</a>
        <a href="/lebenslauf-nico-egerer.pdf" target="_blank" rel="noopener" class="btn btn-light">Lebenslauf (PDF)</a>
      </div>
    </div>
  </section>
</MainLayout>

---
import MainLayout from '../layouts/MainLayout.astro';
import KonturText from '../components/KonturText.astro';
import Scramble from '../components/Scramble.astro';
import CodeFeld from '../components/ui/code-feld';
import { Image } from 'astro:assets';
import ampel from '../assets/ampel.webp';
import game from '../assets/game.webp';
import website from '../assets/website.webp';
---

<MainLayout title="Projekte — Nico Egerer" description="Alle Projekte von Nico Egerer – C++, Python, Web, Raspberry Pi und mehr.">
  <style>
    .projects-section { background: var(--hg); padding: var(--gap-xl) var(--gap-m); }
    .projects-section-inner { max-width: var(--max-w); margin: 0 auto; }
    .filter-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: var(--gap-l); }
    .filter-btn { background: transparent; border: 1.5px solid var(--linie-weich); border-radius: 40px; padding: 0.5rem 1.2rem; font-size: 0.88rem; font-family: var(--font-base); color: var(--txt-leise); cursor: pointer; transition: all 0.2s; }
    .filter-btn:hover { border-color: var(--akzent-2); color: var(--akzent-2); }
    .filter-btn.active { background: var(--hg-betont); border-color: var(--dunkel); color: var(--weiss); }
    .proj-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--gap-m); }
    .proj-card { background: var(--hg-betont); border-radius: var(--r); overflow: hidden; border: 1px solid rgba(255,255,255,0.07); transition: transform 0.3s, box-shadow 0.3s; }
    /* Hier steht die dunkle Karte auf hellem Grund — ein Schatten trägt */
    .proj-card {
      box-shadow:
        calc(var(--sx, 0) * 13px)
        calc(6px + var(--sy, 0) * 9px)
        calc(18px + var(--naehe, 0) * 26px)
        rgba(37, 34, 30, calc(0.12 + var(--naehe, 0) * 0.16));
    }
    .proj-card.hidden { display: none; }
    .proj-img-wrap { position: relative; overflow: hidden; }
    .proj-img { width: 100%; height: 200px; object-fit: cover; display: block; transition: transform 0.4s; }
    .proj-card:hover .proj-img { transform: scale(1.05); }
    .proj-placeholder { background: rgba(255,255,255,0.04); display: flex; align-items: center; justify-content: center; color: rgba(152,213,235,0.5); }
    .proj-placeholder svg { width: 48px; height: 48px; }
    .proj-placeholder.coming { background: linear-gradient(135deg, rgba(152,213,235,0.08), rgba(0,114,181,0.1)); }
    .proj-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.55); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s; }
    .proj-card:hover .proj-overlay { opacity: 1; }
    .proj-info { padding: 1.4rem 1.6rem 1.8rem; }
    .proj-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.5rem; }
    .proj-title { color: var(--weiss); font-family: var(--font-serif); font-size: 1.08rem; font-weight: 500; margin-bottom: 0.5rem; }
    .proj-text { color: rgba(255,255,255,0.5); font-size: 0.88rem; line-height: 1.6; margin-bottom: 1rem; }
    .proj-link { font-size: 0.88rem; color: var(--blau); transition: opacity 0.2s; }
    .proj-link:hover { opacity: 0.7; }
    .proj-badge { display: inline-block; background: rgba(152,213,235,0.15); color: var(--blau); border: 1px solid rgba(152,213,235,0.3); border-radius: 20px; padding: 0.2rem 0.8rem; font-size: 0.78rem; }
    .proj-cta { background: linear-gradient(135deg, var(--hg-betont-2), var(--hg-betont)); padding: var(--gap-xl) var(--gap-m); text-align: center; position: relative; overflow: hidden; }
    .proj-cta-inner { max-width: 620px; margin: 0 auto; position: relative; z-index: 1; }
    .proj-cta-inner p { color: rgba(255,255,255,0.6); font-size: 1rem; margin: 1rem 0 2rem; }
    .cta-reihe { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    /* Der Lichtfleck kommt jetzt aus der gemeinsamen .glanz-schicht der Interaktionsschicht */
    .proj-card { position: relative; isolation: isolate; --glanz-farbe: rgba(152,213,235,0.20); }
    @media (max-width: 900px) { .proj-grid { grid-template-columns: repeat(2,1fr); } }
    /* Die Konturschrift ersetzt den Seitentitel — gleiche optische Groesse, nach oben */
    .proj-titel { max-width: 46rem; margin: 0 0 1rem -0.35rem; }
    @media (max-width: 600px) { .proj-grid { grid-template-columns: 1fr; } }
    /* Die Filter sind auf dieser Seite die einzige echte Bedienung — mit dem Finger */
    @media (pointer: coarse) {
      .filter-btn { padding: 0.85rem 1.3rem; }
      .filter-bar { gap: 0.6rem; }
    }
    @media (max-width: 700px) {
      /* Sieben Karten untereinander: 200px Bildhoehe je Karte ergaben vier Bildschirmlaengen */
      .proj-img { height: auto; aspect-ratio: 16 / 9; }
      .proj-grid { gap: var(--gap-m); }
      .filter-bar { margin-bottom: var(--gap-m); }
    }
  </style>

  <section class="page-hero">
    <div class="page-hero-inner">
      <span class="label white"><Scramble text="Portfolio" /></span>
      <!-- Diese Seite soll zeigen, was ich kann — also ist die Ueberschrift selbst interaktiv -->
      <h1 class="sr-only">Meine Projekte</h1>
      <KonturText text="Meine Projekte" label="Meine Projekte" klasse="proj-titel" />
      <p class="page-hero-sub" data-auf="unschaerfe" data-auf-verzug="120">Von C++ Games über Raspberry Pi Hardware bis hin zu Web-Apps.</p>
    </div>
  </section>

  <section class="projects-section">
    <div class="projects-section-inner">
      <div class="filter-bar reveal">
        <button class="filter-btn active" data-filter="all">Alle</button>
        <button class="filter-btn" data-filter="cpp">C++</button>
        <button class="filter-btn" data-filter="python">Python</button>
        <button class="filter-btn" data-filter="web">Web</button>
        <button class="filter-btn" data-filter="hardware">Hardware</button>
      </div>
      <div class="proj-grid" id="proj-grid" data-staffel="kippen" data-staffel-schritt="90">
        <article class="proj-card leuchtrahmen" data-cat="cpp">
          <div class="proj-img-wrap" data-zeiger="bild"><Image src={game} alt="JumpJump" class="proj-img" quality={72} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 33vw" loading="lazy" /><div class="proj-overlay"><a href="https://jumpjump.nicoegerer.de/" target="_blank" rel="noopener" class="btn btn-outline">Spielen</a></div></div>
          <div class="proj-info"><div class="proj-tags"><span class="tag">C++</span><span class="tag">WASM</span><span class="tag">Shell</span></div><h3 class="proj-title">JumpJump</h3><p class="proj-text">Selbstentwickelter Platformer in C++, kompiliert mit Emscripten zu WebAssembly und direkt im Browser spielbar.</p><a href="https://jumpjump.nicoegerer.de/" target="_blank" rel="noopener" class="proj-link">Jetzt spielen →</a></div>
        </article>
        <article class="proj-card leuchtrahmen" data-cat="python hardware">
          <div class="proj-img-wrap" data-zeiger="bild"><Image src={ampel} alt="Raspberry Pi" class="proj-img" quality={72} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 33vw" loading="lazy" /><div class="proj-overlay"><a href="https://github.com/nicoegerer" target="_blank" rel="noopener" class="btn btn-outline">GitHub</a></div></div>
          <div class="proj-info"><div class="proj-tags"><span class="tag">Python</span><span class="tag">MQTT</span><span class="tag">Node-RED</span><span class="tag">RPi</span></div><h3 class="proj-title">Raspberry Pi Projekte</h3><p class="proj-text">Kreuzungssimulation mit Ampelsteuerung, Luftfeuchtigkeits- und Temperaturmesser mit Node-RED Dashboard.</p><a href="https://github.com/nicoegerer" target="_blank" rel="noopener" class="proj-link">GitHub →</a></div>
        </article>
        <article class="proj-card leuchtrahmen" data-cat="web">
          <div class="proj-img-wrap" data-zeiger="bild"><Image src={website} alt="Website" class="proj-img" quality={72} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 33vw" loading="lazy" /><div class="proj-overlay"><a href="/" class="btn btn-outline">Ansehen</a></div></div>
          <div class="proj-info"><div class="proj-tags"><span class="tag">HTML/CSS</span><span class="tag">JavaScript</span><span class="tag">Figma</span></div><h3 class="proj-title">Persönliche Website</h3><p class="proj-text">Diese Website — von Design in Figma bis Deployment. Vollständig responsiv, ohne Framework, mit eigenem Design-System.</p><a href="/" class="proj-link">Live ansehen →</a></div>
        </article>
        <article class="proj-card leuchtrahmen" data-cat="web">
          <div class="proj-img-wrap" data-zeiger="bild">
            <div class="proj-img proj-placeholder" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="6.5"/><path d="M12 10v3l2 1.5"/><path d="M9 6.5 9.5 3h5l.5 3.5M9 19.5l.5 3.5h5l.5-3.5"/></svg>
            </div>
            <div class="proj-overlay"><a href="https://garmintool.nicoegerer.de/" target="_blank" rel="noopener" class="btn btn-outline">Öffnen</a></div>
          </div>
          <div class="proj-info"><div class="proj-tags"><span class="tag">Web</span><span class="tag">Garmin</span></div><h3 class="proj-title">Garmin Tool</h3><p class="proj-text">Eigenes Werkzeug rund um meine Garmin-Trainingsdaten — läuft unter einer eigenen Subdomain.</p><a href="https://garmintool.nicoegerer.de/" target="_blank" rel="noopener" class="proj-link">Tool öffnen →</a></div>
        </article>
        <article class="proj-card leuchtrahmen" data-cat="cpp">
          <div class="proj-img-wrap" data-zeiger="bild">
            <div class="proj-img proj-placeholder" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/></svg>
            </div>
            <div class="proj-overlay"><a href="https://github.com/nicoegerer" target="_blank" rel="noopener" class="btn btn-outline">GitHub</a></div>
          </div>
          <div class="proj-info"><div class="proj-tags"><span class="tag">C++</span><span class="tag">CMake</span><span class="tag">SDL2</span></div><h3 class="proj-title">C++ Gameloop Engine</h3><p class="proj-text">Experimentelle 2D-Spieleengine mit eigenem Entity-System und Renderer. Basis für JumpJump.</p><a href="https://github.com/nicoegerer" target="_blank" rel="noopener" class="proj-link">Code ansehen →</a></div>
        </article>
        <article class="proj-card leuchtrahmen" data-cat="python">
          <div class="proj-img-wrap" data-zeiger="bild">
            <div class="proj-img proj-placeholder" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/></svg>
            </div>
            <div class="proj-overlay"><a href="https://github.com/nicoegerer" target="_blank" rel="noopener" class="btn btn-outline">GitHub</a></div>
          </div>
          <div class="proj-info"><div class="proj-tags"><span class="tag">Python</span><span class="tag">Automation</span><span class="tag">CLI</span></div><h3 class="proj-title">Python Automatisierungen</h3><p class="proj-text">Sammlung nützlicher Skripte für Automatisierungen, Dateimanagement und kleine CLI-Tools.</p><a href="https://github.com/nicoegerer" target="_blank" rel="noopener" class="proj-link">GitHub →</a></div>
        </article>
        <article class="proj-card leuchtrahmen proj-coming reveal" data-cat="cpp">
          <div class="proj-img-wrap" data-zeiger="bild">
            <div class="proj-img proj-placeholder coming" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v16M4 12h16"/></svg>
            </div>
          </div>
          <div class="proj-info"><div class="proj-tags"><span class="tag">C++</span><span class="tag">Unreal</span><span class="tag">Co-op</span></div><h3 class="proj-title">Nächstes Projekt — TBA</h3><p class="proj-text">Komplexeres Spiel mit Unreal Engine. Co-op-Modus geplant. In aktiver Entwicklung.</p><span class="proj-badge">In Arbeit</span></div>
        </article>
      </div>
    </div>
  </section>

  <!-- Abschluss mit interaktivem Zeichenfeld -->
  <section class="proj-cta">
    <CodeFeld client:visible={{ rootMargin: '300px' }} />
    <div class="proj-cta-inner reveal">
      <span class="label white"><Scramble text="Mehr auf GitHub" /></span>
      <h2 class="section-heading white" data-buchstaben>Alle Repositories ansehen</h2>
      <p>Öffentliche Projekte, Snippets und Experimente — Commit für Commit nachvollziehbar.</p>
      <div class="cta-reihe">
        <a href="https://github.com/nicoegerer" target="_blank" rel="noopener" class="btn btn-outline">GitHub öffnen</a>
        <a href="https://jumpjump.nicoegerer.de/" target="_blank" rel="noopener" class="btn btn-light">JumpJump spielen</a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btns  = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.proj-card');
      btns.forEach(btn => btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const f = (btn as HTMLElement).dataset.filter!;
        cards.forEach(c => {
          const cats = ((c as HTMLElement).dataset.cat || '').split(' ');
          c.classList.toggle('hidden', f !== 'all' && !cats.includes(f));
        });
      }));
    });
  </script>
</MainLayout>

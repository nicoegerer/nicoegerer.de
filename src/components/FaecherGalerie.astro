---
import { getImage } from 'astro:assets';
import SocialCards from './ui/card-fan-carousel';

// Ring innerhalb der Blaetter-Pfeile: auf false setzen, um ihn abzuschalten
const RING_UM_PFEILE = true;

const dateien = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/galerie/*.{webp,jpg,jpeg,png}',
  { eager: true }
);

const zahl = (pfad: string) => Number(pfad.match(/(\d+)\D*$/)?.[1] ?? 0);
const sortiert = Object.entries(dateien).sort((a, b) => zahl(a[0]) - zahl(b[0]));

const texte: Record<string, string> = {};

const BREITEN = [180, 280, 480];
const GROESSEN =
  '(max-width: 479px) 136px, (max-width: 639px) 168px, ' +
  '(max-width: 767px) 192px, (max-width: 1023px) 216px, 240px';

const cards = await Promise.all(
  sortiert.map(async ([pfad, modul]) => {
    const name = pfad.split('/').pop()!.replace(/\.\w+$/, '');
    const bild = await getImage({
      src: modul.default,
      width: BREITEN[BREITEN.length - 1],
      widths: BREITEN,
      sizes: GROESSEN,
      format: 'webp',
      quality: 70,
    });
    return {
      imgUrl: bild.src,
      srcSet: bild.srcSet.attribute,
      sizes: GROESSEN,
      breite: bild.attributes.width ?? modul.default.width,
      hoehe: bild.attributes.height ?? modul.default.height,
      alt: texte[name] ?? '',
    };
  })
);
---

<section class="faecher" aria-labelledby="faecher-titel">
  <div class="faecher-kopf">
    <span class="label">In Bildern</span>
    <h2 class="section-heading dark" id="faecher-titel">Unterwegs</h2>
    <p class="faecher-sub">Berge, Wasser, Schnee und ein paar Städte. Fahr mit der Maus über die Karten oder blättere durch.</p>
  </div>

  <SocialCards cards={cards} ring={RING_UM_PFEILE} autoMs={3000} client:visible={{ rootMargin: '600px' }} />
</section>

<style>
  .faecher { background: var(--hg); padding: var(--gap-xl) var(--gap-m) var(--gap-l); }
  .faecher-kopf { max-width: var(--max-w); margin: 0 auto var(--gap-m); text-align: center; }
  .faecher-sub { color: var(--txt-leise); font-size: 0.98rem; max-width: 46ch; margin: 0 auto; }

  @media (max-width: 900px) {
    .faecher { padding: var(--gap-l) var(--gap-m) var(--gap-m); }
    .faecher-kopf { text-align: left; margin-bottom: var(--gap-s); }
    .faecher-sub { margin-left: 0; }
  }
</style>

---
// Text, der beim Scrollen Stueck fuer Stueck dunkler wird
interface Props {
  /** Wortweises Aufhellen — fuer kurze, wirkungsvolle Absaetze. */
  text?: string;
  /** Absatzweises Aufhellen — fuer Fliesstext. */
  absaetze?: string[];
  klasse?: string;
}
const { text, absaetze, klasse = '' } = Astro.props;
const teile = text ? text.split(' ') : (absaetze ?? []);
const modus = text ? 'wort' : 'absatz';
---

<div class:list={['sa', `sa-${modus}`, klasse]} data-sa data-modus={modus}>
  {modus === 'wort'
    ? teile.map(w => <span class="sa-teil">{w}</span>)
    : teile.map(a => <p class="sa-teil">{a}</p>)}
</div>

<style>
  .sa-wort { display: flex; flex-wrap: wrap; justify-content: center; }
  .sa-absatz { display: flex; flex-direction: column; gap: 1.1rem; }

  /* Die Deckkraft folgt der Scrollposition direkt, ist also schon von sich aus stufenlos */
  .sa-teil { transition: opacity 0.12s linear; }

  .sa-wort .sa-teil {
    margin: 0.3em 0.3em 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.6vw, 3rem);
    font-weight: 400;
    line-height: 1.25;
    /* Eigene Rolle statt Fliesstextton, damit der SW-Modus mitkippt */
    color: var(--txt-lese);
  }
  .sa-absatz .sa-teil {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.8;
    color: inherit;
  }

  /* Abgedunkelt wird nur, wenn das Skript laeuft — den genauen Wert setzt es je Element */
  .sa.aktiv .sa-teil { opacity: 0.16; }

  @media (prefers-reduced-motion: reduce) {
    .sa.aktiv .sa-teil { opacity: 1 !important; }
    .sa-teil { transition: none; }
  }
</style>

<script>
  (() => {
    const sanft = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const felder = [...document.querySelectorAll<HTMLElement>('[data-sa]')];
    if (!felder.length || sanft) return;

    type Feld = { el: HTMLElement; teile: HTMLElement[] };
    const alle: Feld[] = felder.map(el => {
      el.classList.add('aktiv');
      return { el, teile: [...el.querySelectorAll<HTMLElement>('.sa-teil')] };
    });

    const zeichne = () => {
      const h = window.innerHeight;
      // Gedachte Lesekante im unteren Drittel: was darueber steht, ist gelesen und damit hell
      const kante = h * 0.74;
      const band = Math.max(90, h * 0.18); // weicher Uebergang statt harter Kante

      for (const { teile } of alle) {
        for (const t of teile) {
          const r = t.getBoundingClientRect();
          const mitte = r.top + r.height / 2;
          // 0 = noch unter der Kante, 1 = vollstaendig darueber
          const anteil = Math.min(Math.max((kante - mitte) / band, 0), 1);
          t.style.opacity = (0.16 + 0.84 * anteil).toFixed(3);
        }
      }
    };

    // Buendeln, mit Selbstheilung falls requestAnimationFrame nicht ausloest.
    let offen = false, seit = 0;
    const beiScroll = () => {
      const jetzt = performance.now();
      if (offen) { if (jetzt - seit > 150) { offen = false; zeichne(); } return; }
      offen = true; seit = jetzt;
      requestAnimationFrame(() => { offen = false; zeichne(); });
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll);
    zeichne();
  })();
</script>

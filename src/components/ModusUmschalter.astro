---
// Umschalter zwischen Hell und Schwarz/Weiss
---

<button
  class="modus"
  id="modus-knopf"
  type="button"
  aria-label="Zwischen hell und schwarzweiß wechseln"
  aria-pressed="false"
>
  <span class="modus-scheibe" aria-hidden="true">
    <svg class="modus-sonne" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.6v2.3M12 19.1v2.3M4.2 12H1.9M22.1 12h-2.3M6.5 6.5 4.9 4.9M19.1 19.1l-1.6-1.6M17.5 6.5l1.6-1.6M4.9 19.1l1.6-1.6" />
    </svg>
    <svg class="modus-mond" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 13.4A8.4 8.4 0 1 1 10.6 4a6.6 6.6 0 0 0 9.4 9.4z" />
    </svg>
  </span>
</button>

<style>
  .modus {
    position: relative;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    color: var(--weiss);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .modus:hover { transform: scale(1.12); }
  .modus:active { transform: scale(0.94); }

  /* Mit dem Finger bedient braucht der Knopf 44px Trefferflaeche */
  @media (pointer: coarse) {
    .modus { width: 44px; height: 44px; }
  }

  /* Ring, der beim Klick kurz aufzieht — Rueckmeldung direkt am Knopf. */
  .modus::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    opacity: 0;
    transform: scale(0.7);
    pointer-events: none;
  }
  .modus.gedrueckt::after { animation: modus-ring 0.55s ease-out; }
  @keyframes modus-ring {
    0%   { opacity: 0.7; transform: scale(0.7); }
    100% { opacity: 0;   transform: scale(1.7); }
  }

  .modus-scheibe {
    position: relative;
    width: 20px;
    height: 20px;
    display: block;
  }
  .modus-scheibe svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.32s ease, transform 0.42s cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  /* Hell aktiv: Sonne steht, Mond wartet gedreht darunter. */
  .modus-sonne { opacity: 1; transform: rotate(0deg) scale(1); }
  .modus-mond  { opacity: 0; transform: rotate(-70deg) scale(0.5); }

  :root[data-modus='sw'] .modus-sonne { opacity: 0; transform: rotate(70deg) scale(0.5); }
  :root[data-modus='sw'] .modus-mond  { opacity: 1; transform: rotate(0deg) scale(1); }

  @media (prefers-reduced-motion: reduce) {
    .modus, .modus-scheibe svg { transition: none; }
    .modus.gedrueckt::after { animation: none; }
  }
</style>

<script>
  (() => {
    const knopf = document.getElementById('modus-knopf');
    if (!knopf) return;
    const wurzel = document.documentElement;

    const setzen = (modus: string) => {
      wurzel.dataset.modus = modus;
      knopf.setAttribute('aria-pressed', modus === 'sw' ? 'true' : 'false');
      // Die Adressleiste mobiler Browser faerbt sich mit.
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', modus === 'sw' ? '#0d0d0e' : '#98d5eb');
      try { localStorage.setItem('modus', modus); } catch {}
    };

    const wechseln = (ev: MouseEvent) => {
      const neu = wurzel.dataset.modus === 'sw' ? 'hell' : 'sw';

      knopf.classList.remove('gedrueckt');
      void knopf.offsetWidth; // Neustart der Ring-Animation erzwingen
      knopf.classList.add('gedrueckt');

      const sanft = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const kannUebergang = 'startViewTransition' in document;

      if (sanft || !kannUebergang) { setzen(neu); return; }

      // Kreis zieht vom Knopf aus auf
      const r = knopf.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

      wurzel.classList.add('modus-wechselt');
      const uebergang = (document as any).startViewTransition(() => setzen(neu));

      uebergang.ready
        .then(() => {
          wurzel.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
            { duration: 620, easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
              pseudoElement: '::view-transition-new(root)' }
          );
        })
        .catch(() => {});

      uebergang.finished
        .finally(() => wurzel.classList.remove('modus-wechselt'));
    };

    knopf.addEventListener('click', wechseln);
  })();
</script>

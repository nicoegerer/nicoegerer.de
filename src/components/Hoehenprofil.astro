---

const marken = [
  { bei: 0.14, titel: 'Schwimmen', wert: '1,9', einheit: 'km', text: 'Kalt, eng, kein Rhythmus, die ersten Minuten sind reine Kopfsache.' },
  { bei: 0.55, titel: 'Rennrad',   wert: '90',  einheit: 'km', text: 'Der lange Teil. Gleichmäßig treten und nicht zu früh zu viel wollen.' },
  { bei: 0.88, titel: 'Laufen',    wert: '21',  einheit: 'km', text: 'Hier entscheidet sich alles. Die Beine sind leer, der Kopf muss tragen.' },
];
---

<section class="hp" id="hoehenprofil" aria-labelledby="hp-titel">
  <div class="hp-inner">
    <div class="hp-kopf">
      <span class="label" data-auf="seite">Eine Mitteldistanz</span>
      <h2 class="section-heading dark" id="hp-titel" data-buchstaben>Das Profil</h2>
      <p class="hp-sub" data-auf="unschaerfe" data-auf-verzug="140">
        112,9 Kilometer in drei Disziplinen. Scroll die Strecke ab:
        die Linie läuft mit.
      </p>
    </div>

    <div class="hp-buehne" id="hp-buehne">
      <svg class="hp-svg" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="hp-verlauf" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"   stop-color="var(--akzent)" />
            <stop offset="55%"  stop-color="var(--blau)" />
            <stop offset="100%" stop-color="var(--akzent)" />
          </linearGradient>
          <linearGradient id="hp-fuellung" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="var(--blau)" stop-opacity="0.22" />
            <stop offset="100%" stop-color="var(--blau)" stop-opacity="0" />
          </linearGradient>
        </defs>

        <path class="hp-berg hp-berg-fern"
              d="M0 300 L120 196 L210 236 L330 150 L450 214 L560 168 L700 224 L820 158 L920 206 L1000 176 L1000 300 Z" />
        <path class="hp-berg hp-berg-nah"
              d="M0 300 L90 244 L200 268 L320 216 L430 258 L540 226 L680 262 L800 220 L900 254 L1000 232 L1000 300 Z" />

        <path class="hp-flaeche" id="hp-flaeche"
              d="M40 262 L180 258 L250 250 L340 176 L430 208 L520 120 L610 152 L700 96 L760 150 L820 128 L900 186 L960 178 L960 300 L40 300 Z" />
        <path class="hp-linie" id="hp-linie"
              d="M40 262 L180 258 L250 250 L340 176 L430 208 L520 120 L610 152 L700 96 L760 150 L820 128 L900 186 L960 178" />
      </svg>

      <div class="hp-marken" id="hp-marken">
        {marken.map((m, i) => (
          <div class="hp-marke" data-bei={m.bei} data-nr={i}>
            <span class="hp-punkt" aria-hidden="true"></span>
            <div class="hp-karte">
              <span class="hp-zahl"><span data-zaehler={m.wert.replace(',', '.')} data-zaehler-anhang="">0</span>&nbsp;{m.einheit}</span>
              <h3 class="hp-titel">{m.titel}</h3>
              <p class="hp-text">{m.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <p class="hp-fuss" data-auf="schieben">
      <span class="hp-fuss-zahl" data-zaehler="112.9">0</span>&nbsp;km am Stück.
      Und danach die Frage, wann die nächste ist.
    </p>
  </div>
</section>

<style>
  .hp { background: var(--hg); padding: var(--gap-xl) var(--gap-m); }
  .hp-inner { max-width: var(--max-w); margin: 0 auto; }
  .hp-kopf { max-width: 46ch; margin-bottom: var(--gap-l); }
  .hp-sub { color: var(--txt-warm-tief); font-size: 1.05rem; line-height: 1.7; margin-top: 0.6rem; }

  .hp-buehne { position: relative; }
  .hp-svg { display: block; width: 100%; height: clamp(200px, 30vh, 320px); overflow: visible; }

  .hp-berg { fill: var(--linie); opacity: 0.5; transform: translate3d(0, var(--py, 0px), 0); }
  .hp-berg-fern { opacity: 0.32; }
  .hp-flaeche { fill: url(#hp-fuellung); opacity: 0; transition: opacity 0.9s ease; }
  .hp-buehne.laeuft .hp-flaeche { opacity: 1; }

  .hp-linie {
    fill: none;
    stroke: url(#hp-verlauf);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: var(--laenge, 2000);
    stroke-dashoffset: calc(var(--laenge, 2000) * (1 - var(--fortschritt, 0)));
  }

  .hp-marken { position: absolute; inset: 0; pointer-events: none; }
  .hp-marke {
    position: absolute;
    top: 0;
    left: var(--x, 0%);
    transform: translate3d(-50%, 0, 0);
    pointer-events: auto;
  }
  .hp-punkt {
    position: absolute;
    top: var(--y, 50%);
    left: 50%;
    width: 13px; height: 13px;
    margin: -6.5px 0 0 -6.5px;
    border-radius: 50%;
    background: var(--hg);
    border: 3px solid var(--akzent);
    transform: scale(0);
    transition: transform 0.42s cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  .hp-marke.erreicht .hp-punkt { transform: scale(1); }
  .hp-marke.erreicht .hp-punkt::after {
    content: '';
    position: absolute; inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--akzent);
    animation: hp-puls 0.9s ease-out 1;
  }
  @keyframes hp-puls {
    from { transform: scale(0.7); opacity: 0.8; }
    to   { transform: scale(2.6); opacity: 0; }
  }

  .hp-karte {
    position: absolute;
    top: calc(var(--y, 50%) + 26px);
    left: 50%;
    width: min(15rem, 42vw);
    transform: translate3d(-50%, 10px, 0);
    background: var(--hg-2);
    border: 1px solid var(--linie);
    border-radius: var(--r-s);
    padding: 0.85rem 1rem;
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .hp-marke.erreicht .hp-karte { opacity: 1; transform: translate3d(-50%, 0, 0); }

  .hp-zahl { display: block; font-family: var(--font-serif); font-size: 1.5rem; color: var(--txt-voll); line-height: 1; }
  .hp-titel { font-size: 0.88rem; font-weight: 600; color: var(--akzent); margin: 0.35rem 0 0.3rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .hp-text { font-size: 0.84rem; line-height: 1.55; color: var(--txt-leise); margin: 0; }

  .hp-fuss {
    margin-top: calc(var(--gap-l) + 5rem);
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    color: var(--txt-lese);
    max-width: 34ch;
  }
  .hp-fuss-zahl { color: var(--akzent); }

  @media (max-width: 820px) {
    .hp-svg { height: auto; aspect-ratio: 1000 / 340; }

    .hp-marken {
      position: static;
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-top: 1.2rem;
      border-left: 2px solid var(--linie);
      padding-left: 1.1rem;
    }
    .hp-marke {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      padding: 0.65rem 0;
      opacity: 0.4;
      transition: opacity 0.45s ease;
    }
    .hp-marke.erreicht { opacity: 1; }

    .hp-punkt {
      display: block;
      position: absolute;
      top: 1.15rem;
      left: -1.1rem;
      margin: 0;
      transform: translate(-50%, -50%) scale(0);
      width: 11px; height: 11px;
      border-width: 2px;
    }
    .hp-marke.erreicht .hp-punkt { transform: translate(-50%, -50%) scale(1); }

    .hp-marke.erreicht .hp-karte { transform: none; }

    .hp-karte {
      position: static;
      width: auto;
      transform: none;
      opacity: 1;
      background: none;
      border: none;
      box-shadow: none;
      padding: 0;
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 0 0.6rem;
    }
    .hp-zahl  { font-size: 1.2rem; grid-column: 1; }
    .hp-titel { font-size: 0.74rem; margin: 0; grid-column: 2; letter-spacing: 0.06em; }
    .hp-text  { grid-column: 1 / -1; margin-top: 0.25rem; font-size: 0.86rem; }

    .hp-fuss { margin-top: var(--gap-m); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-linie { stroke-dashoffset: 0; }
    .hp-punkt { transform: scale(1); }
    .hp-karte { opacity: 1; transform: translate3d(-50%, 0, 0); }
    .hp-marke.erreicht .hp-punkt::after { animation: none; }
    .hp-flaeche { opacity: 1; }
  }
</style>

<script>
  import { zaehlerStarten } from '../scripts/scrollen';

  (() => {
    const buehne = document.getElementById('hp-buehne');
    const linie  = document.getElementById('hp-linie') as SVGPathElement | null;
    if (!buehne || !linie) return;

    const marken = [...buehne.querySelectorAll<HTMLElement>('.hp-marke')];
    const sanft = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const laenge = linie.getTotalLength();
    buehne.style.setProperty('--laenge', String(laenge));

    const kasten = linie.getBBox();
    for (const m of marken) {
      const bei = parseFloat(m.dataset.bei || '0');
      const p = linie.getPointAtLength(laenge * bei);
      m.style.setProperty('--x', (p.x / 1000 * 100).toFixed(2) + '%');
      m.style.setProperty('--y', (p.y / 300 * 100).toFixed(2) + '%');
    }
    void kasten;

    if (sanft) {
      buehne.classList.add('laeuft');
      for (const m of marken) { m.classList.add('erreicht'); zaehlerStarten(m); }
      return;
    }

    const zeichne = () => {
      const r = buehne.getBoundingClientRect();
      const h = window.innerHeight;
      const start = h * 0.85;
      const ende  = h * 0.3;
      const roh = (start - r.top) / (start - ende);
      const t = roh < 0 ? 0 : roh > 1 ? 1 : roh;

      buehne.style.setProperty('--fortschritt', t.toFixed(4));
      buehne.classList.toggle('laeuft', t > 0.02);
      for (const m of marken) {
        const erreicht = t >= parseFloat(m.dataset.bei || '0');
        m.classList.toggle('erreicht', erreicht);
        if (erreicht) zaehlerStarten(m);
      }
    };

    let offen = false, seit = 0;
    const beiScroll = () => {
      const jetzt = performance.now();
      if (offen) { if (jetzt - seit > 150) { offen = false; zeichne(); } return; }
      offen = true; seit = jetzt;
      requestAnimationFrame(() => { offen = false; zeichne(); });
    };
    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll);
    zeichne();
  })();
</script>
